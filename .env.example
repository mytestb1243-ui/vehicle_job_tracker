# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/vehiclejobtracker_db

# Random long random string used to sign session cookies. Change this in production.
SECRET_KEY=change-this-to-a-long-random-string

# App name shown in the navbar, browser title and login page
APP_NAME=Vehicle Job Tracker

# Default Super Admin account created the first time you run scripts/init_db.py
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password
DEFAULT_ADMIN_FULLNAME=System Administrator

# Session cookie lifetime, in seconds (default 8 hours)
SESSION_MAX_AGE=28800
